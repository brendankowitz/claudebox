<Window x:Class="ClaudeBox.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeBox Settings" 
        Height="300" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Settings" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- Refresh Interval -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Refresh Interval" 
                       Foreground="#CCCCCC" 
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="RefreshIntervalCombo"
                      SelectedIndex="2"
                      Background="#333333"
                      Foreground="White">
                <ComboBoxItem Content="1 minute" Tag="1"/>
                <ComboBoxItem Content="2 minutes" Tag="2"/>
                <ComboBoxItem Content="5 minutes" Tag="5"/>
                <ComboBoxItem Content="15 minutes" Tag="15"/>
                <ComboBoxItem Content="30 minutes" Tag="30"/>
            </ComboBox>
        </StackPanel>

        <!-- CLI Status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Claude CLI Status" 
                       Foreground="#CCCCCC" 
                       Margin="0,0,0,5"/>
            <TextBlock x:Name="CliStatusTextBlock"
                       Text="Checking..." 
                       Foreground="#888888"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- About -->
        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,15">
            <TextBlock Text="About" 
                       Foreground="#CCCCCC" 
                       Margin="0,0,0,5"/>
            <TextBlock Foreground="#888888" TextWrapping="Wrap">
                <Run Text="ClaudeBox is a Windows system tray application that displays your Claude quota usage. "/>
                <Run Text="Inspired by CodexBar for macOS."/>
            </TextBlock>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Save" 
                    Click="SaveButton_Click"
                    Width="80" 
                    Height="30"
                    Margin="0,0,10,0"
                    Background="#FF9562"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Cancel" 
                    Click="CancelButton_Click"
                    Width="80" 
                    Height="30"
                    Background="#555555"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
