<UserControl x:Class="ClaudeBox.Views.QuotaPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:ClaudeBox.ViewModels"
             Width="320"
             Background="#1E1E1E">
    <Border BorderBrush="#333333" 
            BorderThickness="1" 
            CornerRadius="8"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Claude Quota Usage" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="White"/>
                <TextBlock x:Name="AccountText"
                           Text="{Binding AccountText}"
                           FontSize="12" 
                           Foreground="#888888"
                           Visibility="{Binding AccountText, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock x:Name="PlanText"
                           Text="{Binding PlanText}"
                           FontSize="12" 
                           Foreground="#888888"
                           Visibility="{Binding PlanText, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 5-Hour Usage -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="5-Hour Window" 
                               Foreground="#CCCCCC" 
                               FontSize="13"/>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding HourlyUsage, StringFormat={}{0:F1}% used}"
                               Foreground="#FF9562" 
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Grid>
                <ProgressBar Value="{Binding HourlyUsage}" 
                             Maximum="100" 
                             Height="8" 
                             Margin="0,4,0,0"
                             Foreground="#FF9562"
                             Background="#333333">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4">
                                            <Border x:Name="PART_Track" 
                                                    CornerRadius="4">
                                                <Border x:Name="PART_Indicator"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding HourlyResetText}" 
                           Foreground="#666666" 
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Weekly Usage -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Weekly Window" 
                               Foreground="#CCCCCC" 
                               FontSize="13"/>
                    <TextBlock Grid.Column="1" 
                               Text="{Binding WeeklyUsage, StringFormat={}{0:F1}% used}"
                               Foreground="#4CAF50" 
                               FontSize="13"
                               FontWeight="SemiBold"/>
                </Grid>
                <ProgressBar Value="{Binding WeeklyUsage}" 
                             Maximum="100" 
                             Height="8" 
                             Margin="0,4,0,0"
                             Foreground="#4CAF50"
                             Background="#333333">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4">
                                            <Border x:Name="PART_Track" 
                                                    CornerRadius="4">
                                                <Border x:Name="PART_Indicator"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Background="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding WeeklyResetText}" 
                           Foreground="#666666" 
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Status -->
            <TextBlock Grid.Row="3" 
                       Text="{Binding StatusText}"
                       Foreground="#666666" 
                       FontSize="11"
                       Margin="0,4,0,12"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Content="↻ Refresh" 
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}"
                        Width="90" 
                        Height="28"
                        Margin="0,0,8,0"
                        Background="#FF9562"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="⚙ Settings" 
                        Command="{Binding OpenSettingsCommand}"
                        Width="90" 
                        Height="28"
                        Background="#555555"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- CLI Status Warning -->
            <TextBlock Grid.Row="5" 
                       Text="{Binding CliStatusText}"
                       Foreground="#F44336" 
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="{Binding CliAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>
